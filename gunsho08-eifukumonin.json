 "poems": [
  {
   "seq": "1",
   "text": "あらぬ方に聞き果るこそ戀しけれ空しきまてに賴まゝしよを",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "恥しやおもへはいかに思ふらむ心のまゝにうらみつることを",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "みる人も物を思はぬさまなれは心のうらをたれにかたらむ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "幾たひかもの思はしとすつれともこゝろの下に戀しき物を",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "まことかと嬉しかりつる一言にさらなる思ひまた色そそふ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "人を只恨ることそなかるへきそれによらずはさそいかにせん",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "一すちにこひたつ夜半のそのうちは待より外の事もましらす",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "いかゝあらん今夜さてもの行ゑより空なる月そ常にみらるゝ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "けふの日よいかなる日そと人もうく身も恨めしく人も戀しき",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "思ふ〓との慰ますのみなりゆけはあるましきかと身そ哀なる",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "見るもうく聞るゝもうき同し世といとふかはては又そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "思へかし哀ならてもいかゝあらん馴てひさしきなかの契りそ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "僞はかくれぬ物をさらはたゝまたとも何と人のいふらむ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "うきともくやしきともさこそはと思ひし方そたかはさりける",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "人も我を思ひつらむと思ひせは嬉しくやぁらん悲しくやあらん",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "思はすと恨みし人のあやにくにわれしたのめは又うくそなる",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "戀しきそ思ふそとのみいひしかとそのしるしなる一言もなし",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "しのはれす思はれまさるはてはたゝうき身の上も忘られそ行",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "變るかと人のけしきの見え行くにたゝさま〓〓にそふ思ひ哉",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "つらきあまりおもひとゝむと思ふ程の心に過て何か悲しき",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "うき世にはなからへんともおもはねと命のまゝに哀ゆく身を",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "憂きかうきは易くやはあらむ人は唯哀れなるこそ猶うかりけれ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "何故にとはさりつるといはんより思ひなからと聞はうらめし",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "いましたゝ哀かけなむ行末をみはつるまては身のあらはこそ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "あはぬまは今はあはしと思へ共逢ふとしあへはあはんとそ思",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "あひみんといふともよもや道もあらし我に知れぬ僞も哉",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "さりともとおもふ心を過ゆけはなにしかゝりて思ひしもせん",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "今さらに思ふ〓とこそおもはるれ雨のふるにも風の吹にも",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "かはりはてし人は殘らぬいにしへを忍ふ心に忘れかねぬる",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "世ゝへても哀なりしそわすられぬうきを久しと誰かいひけん",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "あさからすみえし情の程もへぬされはかくこそなる世也けれ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "しりぬれは我こそ心悲しけれたゝ憂きふしはきかしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "よそなからその佛をみるかこと心のうちをしる〓ともかな",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "有りしうちかあらす成りぬる今のみかされは一方は夢かとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "ためしなのうさやつらさやこのきはゝ侘てやしたふ恨てやのく",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "恨みてもなけきてもけに果はたゝ我を思へといはまくほしき",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "思〓とにあまたの時を移すなかよいつの逢日をまちたにもせす",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "おもひいて又思ひのみ出くれはいかにも人を忘れかねぬる",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "君にかくなれすは何に慰まむうきおり〓ははくやしけれとも",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いかにとは君を心にますそ思ふあすしらぬよの定めなきにも",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
